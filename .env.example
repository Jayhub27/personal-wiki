# Copy to .env and fill in what you need. Never commit .env.

# --- Server ---
PORT=3210

# --- Storage backend: files (default) | supabase | vercel ---
STORAGE_ADAPTER=files
# CONTENT_DIR=./content
# UPLOAD_DIR=./public/uploads

# --- Auth (optional; enables login when set) ---
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me
# AUTH_PASSWORD_HASH=
# Multiple accounts sharing one wiki (JSON of username -> sha256 password hash):
# AUTH_USERS={"alice":"<sha256-hex>","bob":"<sha256-hex>"}
# SESSION_SECRET=generate-a-long-random-string

# --- Supabase (storage + media) ---
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_MEDIA_BUCKET=media
# MEDIA_ADAPTER=supabase

# --- Migrations (only for the scripts/migrate.mjs runner) ---
# DATABASE_URL=postgres://user:pass@host:5432/db

# --- Optional AI "Ask the wiki" (any OpenAI-compatible endpoint) ---
# AI_API_KEY=sk-...
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
